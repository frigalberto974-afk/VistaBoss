# Variabili da impostare su Netlify (Site configuration > Environment variables). Mai nel codice.
ANTHROPIC_API_KEY=
# Contenuto completo del file JSON della chiave dell'account di servizio Google.
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID del calendario "Agenda VistaBoss" (…@group.calendar.google.com).
GOOGLE_CALENDAR_ID=
# PIN che il titolare digita la prima volta sul telefono.
APP_PIN=
# Stringa casuale lunga per firmare le azioni in attesa di conferma.
APP_SECRET=
